# Copy to .env and adjust as needed. Used by docker-compose.yml (via
# `make dev`, which passes --env-file .env) and by apps/api's config loader
# when running outside Docker.

# --- App ---
APP_ENV=development
API_PORT=8080
COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Optional: OTLP-HTTP collector host:port (e.g. localhost:4318). Leave unset
# to disable tracing entirely, no network calls attempted.
# OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Postgres ---
POSTGRES_USER=internity
POSTGRES_PASSWORD=internity
POSTGRES_DB=internity
POSTGRES_PORT=5432
DATABASE_URL=postgres://internity:internity@localhost:5432/internity?sslmode=disable

# --- Redis ---
REDIS_PORT=6379
REDIS_URL=localhost:6379

# --- MinIO ---
MINIO_ROOT_USER=internity
MINIO_ROOT_PASSWORD=internity123
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=internity
MINIO_SECRET_KEY=internity123

# --- Frontend ports (docker-compose only) ---
DASHBOARD_PORT=5173
LANDING_PORT=3000

# --- Frontend env (apps/dashboard, apps/landing) ---
VITE_API_BASE_URL=http://localhost:8080
VITE_MINIO_URL=http://localhost:9000
NUXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
