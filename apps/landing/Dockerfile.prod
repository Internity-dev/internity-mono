# syntax=docker/dockerfile:1
# nuxt.config.ts pins nitro.preset to "static": `nuxt build` fully
# prerenders the site into .output/public (Nitro itself suggests `npx serve
# .output/public` to preview it), so production needs a static file server,
# not a Node process running .output/server — there is no server bundle to
# run. Build context is the monorepo root, same as the dev Dockerfile.
FROM node:22-alpine AS builder
WORKDIR /repo
RUN corepack enable
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml ./
COPY packages/design-tokens ./packages/design-tokens
COPY apps/landing ./apps/landing
RUN pnpm install --frozen-lockfile
# packages/design-tokens/dist is gitignored (generated locally, never
# committed) — a fresh clone has no dist/theme.css until this runs, and
# landing's main.css imports @internity/design-tokens/theme.css.
RUN pnpm run tokens:build
WORKDIR /repo/apps/landing

# Nuxt bakes runtimeConfig.public into the prerendered payload at build time,
# so these arrive as build args here rather than runtime environment on the
# nginx stage below.
ARG NUXT_PUBLIC_API_BASE_URL
ARG NUXT_PUBLIC_DASHBOARD_URL
ENV NUXT_PUBLIC_API_BASE_URL=$NUXT_PUBLIC_API_BASE_URL
ENV NUXT_PUBLIC_DASHBOARD_URL=$NUXT_PUBLIC_DASHBOARD_URL
RUN pnpm run build

FROM nginxinc/nginx-unprivileged:alpine AS runtime
COPY apps/landing/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /repo/apps/landing/.output/public /usr/share/nginx/html
EXPOSE 8080
