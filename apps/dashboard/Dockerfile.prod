# syntax=docker/dockerfile:1
# Production build: static assets only, served by nginx (no dev server, no
# source bind-mounts). Build context is the monorepo root so pnpm workspaces
# (design-tokens) resolve, same as the dev Dockerfile.
FROM node:22-alpine AS builder
WORKDIR /repo
RUN corepack enable
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml ./
COPY packages/design-tokens ./packages/design-tokens
COPY apps/dashboard ./apps/dashboard
RUN pnpm install --frozen-lockfile
WORKDIR /repo/apps/dashboard

# Vite bakes VITE_* vars into the bundle at build time, so they arrive as
# build args here rather than runtime environment on the nginx stage below.
ARG VITE_API_BASE_URL
ARG VITE_MINIO_URL
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
ENV VITE_MINIO_URL=$VITE_MINIO_URL
RUN pnpm run build

FROM nginxinc/nginx-unprivileged:alpine AS runtime
COPY apps/dashboard/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /repo/apps/dashboard/dist /usr/share/nginx/html
EXPOSE 8080
