# Paste this whole block into Dokploy's "Environment" tab for this compose
# project (fill in real values first), then set "Compose Path" to
# deploy/docker-compose.dokploy.yml. Dokploy writes what you paste to a .env
# file next to that compose file, which Docker Compose's own ${VAR}
# interpolation picks up automatically — no other wiring needed.
#
# Every var below is required (no weak inline fallback) — compose refuses to
# start with a clear error naming whichever one is missing.
#
# There are no *_PORT vars here (unlike .env.prod.example): this compose file
# doesn't publish any host ports. Dokploy's Traefik reaches api/dashboard/
# landing over dokploy-network by container port instead — set that up per
# service in Dokploy's Domains tab after the first deploy. See
# docs/dokploy.md for the exact steps.

# --- Postgres ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=internity

# --- MinIO ---
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# --- App ---
# Public origins allowed to call the API (your dashboard + landing domains).
CORS_ALLOWED_ORIGINS=https://app.example.com,https://example.com

# Baked into the dashboard's build at image-build time (Vite env vars are
# compile-time, not runtime) — the API's and MinIO's public URLs.
DASHBOARD_API_BASE_URL=https://api.example.com
DASHBOARD_MINIO_URL=https://files.example.com

# Baked into the landing site's prerendered output at image-build time
# (Nuxt's static preset has no server process to read env vars at runtime).
LANDING_API_BASE_URL=https://api.example.com/api/v1
LANDING_DASHBOARD_URL=https://app.example.com

# --- Optional ---
# OTLP-HTTP collector host:port; unset disables tracing entirely
# OTEL_EXPORTER_OTLP_ENDPOINT=
